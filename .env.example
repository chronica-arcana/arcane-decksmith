# Firebase Web-Konfiguration (Firebase Console → Projekteinstellungen → Web-App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: eigener Proxy für den URL-Import (Standard: Firebase Callable Function)
# VITE_IMPORT_PROXY_URL=

# Optional: eigene Cloudflare-Worker-URLs für KI-Analyse und Deck-Intelligence
# (Standard: https://arcane-decksmith-ai.arcane-decksmith-api.workers.dev)
# VITE_AI_WORKER_URL=
# VITE_DECK_INTELLIGENCE_URL=

# Optional: öffentliche Basis-URL der Seite (für og:image), z. B. https://chronica-arcana.github.io/arcane-decksmith/
# VITE_SITE_URL=
